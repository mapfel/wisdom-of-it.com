<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Misc.fs" />
    <Compile Include="Markdown.fs" />
    <Compile Include="Formatting.fs" />
    <Compile Include="FsReveal.fs" />
    <None Include="template.html" />
    <None Include="fsreveal.css" />
  </ItemGroup>

  <ItemGroup>
    <!-- FSharp.Formatting pins this exact FSharp.Core via FSharp.Compiler.Service -->
    <PackageReference Update="FSharp.Core" Version="10.1.204" />
    <PackageReference Include="FSharp.Formatting" Version="22.2.0" />
  </ItemGroup>

</Project>
